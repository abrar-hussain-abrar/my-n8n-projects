{
  "name": "Create_slots_workflow",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const slots = [];\nconst today = new Date(); \n\n// This forces the date to the start of today in Pakistan Time (UTC+5)\n// If you want to create slots for TODAY:\nconst year = today.getFullYear();\nconst month = today.getMonth();\nconst day = today.getDate();\n\n// 9 AM Pakistan (PKT) is 4 AM UTC\n// 5 PM Pakistan (PKT) is 12 PM UTC\nconst startHourUTC = 4; \nconst endHourUTC = 12; \n\nfor (let hour = startHourUTC; hour < endHourUTC; hour++) {\n  [0, 30].forEach(minutes => {\n    let s = new Date(Date.UTC(year, month, day, hour, minutes, 0));\n    let e = new Date(Date.UTC(year, month, day, hour, minutes + 30, 0));\n\n    slots.push({\n      json: {\n        resourceType: \"Slot\",\n        status: \"free\",\n        start: s.toISOString(),\n        end: e.toISOString(),\n        schedule: { reference: \"Schedule/50a9fdce-1d86-4411-ada2-5ba7770ea88e\" }\n      }\n    });\n  });\n}\n\nreturn slots;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
