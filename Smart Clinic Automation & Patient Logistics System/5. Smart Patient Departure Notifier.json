    {
      "parameters": {
        "jsCode": "// 1. Parse the Appointment data string\nconst appointmentData = JSON.parse($node[\"Get Appointments\"].json.data);\nconst appointments = appointmentData.entry || [];\n\n// 2. Parse the Directions data string\nconst travelData = JSON.parse($node[\"Get Directions\"].json.data);\nconst travelTimeSeconds = travelData.features[0].properties.summary.duration;\nconst travelTimeMinutes = Math.ceil(travelTimeSeconds / 60);\n\n// 3. Define Doctor's Speed (Average minutes per patient)\nconst minsPerPatient = 15; \n\n// 4. Calculate Queue (count patients with status 'arrived' or 'booked' BEFORE Abrar)\n// For this example, let's say Abrar is the last one in the bundle\nconst waitingPatients = appointments.filter(a => a.resource.status === 'arrived').length;\nconst totalWaitTime = (waitingPatients - 1) * minsPerPatient; // Wait for people ahead of him\n\n// 5. Final Calculation\nconst leaveInMinutes = totalWaitTime - travelTimeMinutes;\n\nreturn {\n  patientName: \"Abrar\",\n  travelTime: travelTimeMinutes,\n  queueWaitTime: totalWaitTime,\n  suggestedLeaveIn: leaveInMinutes > 0 ? leaveInMinutes : 0,\n  message: leaveInMinutes > 0 \n    ? `Hi Abrar, your drive is ${travelTimeMinutes} mins. There are patients ahead of you. Please leave your house in ${leaveInMinutes} minutes.`\n    : `Hi Abrar, your drive is ${travelTimeMinutes} mins. Please leave now to reach on time!`\n};"
      },
